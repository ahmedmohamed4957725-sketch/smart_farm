        "description": "ensure table \"users\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"users\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"users\"",
        "sql": "CREATE TABLE \"public\".\"users\" (\n  \"created_at\" timestamp DEFAULT (now()) NOT NULL,\n  \"email\" text NOT NULL,\n  \"google_id\" character varying(255),\n  \"id\" BIGSERIAL NOT NULL,\n  \"is_active\" bool DEFAULT true NOT NULL,\n  \"name\" character varying(255) NOT NULL,\n  \"password\" text,\n  CONSTRAINT \"users_pkey\" PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"users\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"users\""
        ]
      }
    ]
  },
