// use prisma-8

model Users {
  id        BigInt        @id(map: "users_pkey") @default(autoincrement())
  name      VarChar(255)
  email     String        @unique(map: "users_email_key")
  password  String?
  createdAt Timestamp     @default(now()) @map("created_at")
  googleId  VarChar(255)? @unique(map: "users_google_id_key") @map("google_id")
  isActive  Boolean       @default(true) @map("is_active")
  updatedAt Timestamp     @default(now()) @map("updated_at")

  farms Farm[]

  @@map("users")
}

model Crop {
  id          BigInt @id @default(autoincrement())
  name        VarChar(255)
  description String?

  fields Field[]

  @@map("crop")
}

model Farm {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  name      VarChar(255)
  location  String
  area      Numeric(10, 2)
  createdAt Timestamp @default(now())
  updatedAt Timestamp @default(now())
  user   Users  @relation(fields: [userId], references: [id])
  fields Field[]

  @@map("farm")
}

model Field {
  id        BigInt   @id @default(autoincrement())
  farmId    BigInt
  cropId    BigInt?
  name      VarChar(255)
  area      Numeric(10, 2)
  createdAt Timestamp @default(now())
  updatedAt Timestamp @default(now())
  farm Farm  @relation(fields: [farmId], references: [id])
  crop Crop? @relation(fields: [cropId], references: [id])

  @@map("field")
}